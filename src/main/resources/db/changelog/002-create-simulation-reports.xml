<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-simulation-reports" author="salvador">

        <createTable tableName="simulation_reports">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="tourists_remaining" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="total_escapes" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="total_attacks" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="total_evacuated" type="INT">
                <constraints nullable="false" />
            </column>
            <column name="safety_score" type="DOUBLE PRECISION">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" />
        </createTable>

    </changeSet>

</databaseChangeLog>